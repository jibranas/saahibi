# Same PostHog project as saahibi-website. Public project token; still keep it
# out of git. For Play / EAS production builds, set it on Expo after login:
#   npx eas-cli env:create --name EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN --environment production --visibility sensitive --non-interactive --value "$EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN"
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Backend base URL, no trailing slash. Leave unset in local development to
# fall back to the Expo dev machine on :3000. Production / Play builds use
# https://saahibi.vercel.app (see eas.json).
EXPO_PUBLIC_API_URL=https://saahibi.vercel.app
