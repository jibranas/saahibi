# Same PostHog project as saahibi-website
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Backend base URL, no trailing slash. Leave unset in local development to
# fall back to the Expo dev machine on :3000.
EXPO_PUBLIC_API_URL=https://your-deployment.vercel.app
