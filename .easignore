# Starts from .gitignore, then extra EAS upload exclusions.
# A .easignore replaces .gitignore for the EAS archive.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders at repo root (not saahibi-app/android)
/ios
/android

# Local native build output — EAS compiles these itself
saahibi-app/android/app/build/
saahibi-app/android/build/
saahibi-app/android/.gradle/
saahibi-app/ios/Pods/
saahibi-app/ios/build/

# server is not needed to build the app
saahibi-express-server/
