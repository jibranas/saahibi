# Copy to `.env` in this folder.

MONGODB_URI=
PORT=3000
OPENAI_API_KEY=

# Optional. When set, mutating /api/admin/* requires:
#   Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=

# Optional. Compute every lesson at startup so no reader waits for a cold one.
# Adds ~6s of background work after boot. Defaults to on when
# NODE_ENV=production; set to 1 or 0 to force it either way.
# Set to 0 on serverless — there is no boot phase to warm, and it would
# self-request over 127.0.0.1, which does not resolve to the function.
WARM_LESSON_CACHE=

# Optional. Public CDN for word MP3s (Cloudflare R2 custom domain).
# Used by scripts/import-quran-word-audio.py when writing Mongo audioPath.
WORD_AUDIO_PUBLIC_BASE_URL=https://audio.saahibi.com
